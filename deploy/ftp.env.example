# Copy to deploy/ftp.env and fill in. deploy/ftp.env is gitignored — never commit it.
# Use the MAIN cPanel FTP account (its home is /home/<cpanel-user>), same values as the GitHub secrets.
FTP_HOST=ftp.example.com
FTP_USER=cpaneluser
FTP_PASSWORD=

# ftps (recommended) or ftp
FTP_PROTOCOL=ftps
# Set to "no" only if FTPS fails with a certificate error (cert issued for the server hostname, not your FTP host)
FTP_VERIFY_CERT=yes

# Folders relative to the FTP account's home
FTP_APP_DIR=sparingin
FTP_WEB_DIR=public_html

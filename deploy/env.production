# ───────────────────────────────────────────────────────────────
# SparingIn — production .env (shared hosting / cPanel)
# Isi bagian bertanda  <<< GANTI  sebelum website dibuka.
# APP_KEY sudah dibuat otomatis oleh deploy/build.sh — JANGAN dibagikan.
# ───────────────────────────────────────────────────────────────

APP_NAME=SparingIn
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Alamat website persis seperti dibuka di browser, tanpa garis miring di akhir   <<< GANTI
APP_URL=https://GANTI-DOMAIN-KAMU

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Dari cPanel → MySQL Databases (nama DB & user biasanya diawali username cPanel)   <<< GANTI
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=GANTI_cpaneluser_sparingin
DB_USERNAME=GANTI_cpaneluser_sparingin
DB_PASSWORD=GANTI_PASSWORD_DATABASE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Ubah ke true setelah website memakai HTTPS (SSL aktif)
SESSION_SECURE_COOKIE=false

# Folder upload publik (foto pemain, logo, poster) — langsung di public_html/storage,
# karena shared hosting tanpa SSH tidak bisa menjalankan `php artisan storage:link`.   <<< GANTI cpaneluser
PUBLIC_STORAGE_PATH=/home/GANTI_cpaneluser/public_html/storage
FILESYSTEM_DISK=local

# Tanpa cron/worker di shared hosting: jalankan job langsung
QUEUE_CONNECTION=sync
CACHE_STORE=database
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
